# OAuth configuration used by the trusted Rust/backend layer.
BACKLOG_REDIRECT_URL=http://127.0.0.1:38421/oauth/callback
BACKLOG_CLIENT_ID=your-backlog-client-id
BACKLOG_CLIENT_SECRET=your-backlog-client-secret

# Public values available to the Vite frontend.
VITE_BACKLOG_REDIRECT_URL=http://127.0.0.1:38421/oauth/callback
VITE_BACKLOG_CLIENT_ID=your-backlog-client-id

# Do not add VITE_BACKLOG_CLIENT_SECRET. Vite exposes VITE_* variables in the
# shipped JavaScript bundle.
